generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum CommentStatus {
  APPROVED
  HIDDEN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PageView {
  id         String   @id @default(cuid())
  articleSlug String
  viewerId   String
  createdAt  DateTime @default(now())

  @@index([articleSlug, createdAt])
  @@index([viewerId, createdAt])
}

model ArticleLike {
  id          String   @id @default(cuid())
  articleSlug String
  viewerId    String
  createdAt   DateTime @default(now())

  @@unique([articleSlug, viewerId])
  @@index([articleSlug, createdAt])
}

model Comment {
  id          String   @id @default(cuid())
  articleSlug String
  authorName  String
  content     String
  status      CommentStatus @default(APPROVED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([articleSlug, createdAt])
  @@index([status, createdAt])
}
