generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum CommentStatus {
  APPROVED
  HIDDEN
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  name               String?
  passwordHash       String
  role               UserRole          @default(USER)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lastEditedArticles Article[]         @relation("ArticleLastEditedBy")
  articleRevisions   ArticleRevision[] @relation("ArticleRevisionCreatedBy")
}

model Article {
  id                 String            @id @default(cuid())
  slug               String            @unique
  title              String
  desc               String
  content            String
  category           String
  tags               String[]
  cover              String
  searchDocument     String            @default("")
  draft              Boolean           @default(true)
  publishedAt        DateTime
  legacySourcePath   String?
  lastEditedByUserId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lastEditedBy       User?             @relation("ArticleLastEditedBy", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)
  revisions          ArticleRevision[]

  @@index([draft, publishedAt])
  @@index([category, publishedAt])
}

model ArticleRevision {
  id              String   @id @default(cuid())
  articleId       String
  title           String
  desc            String
  content         String
  category        String
  tags            String[]
  cover           String
  draft           Boolean
  publishedAt     DateTime
  createdByUserId String?
  createdAt       DateTime @default(now())
  reason          String?
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("ArticleRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([createdByUserId, createdAt])
}

model PageView {
  id         String   @id @default(cuid())
  articleSlug String
  viewerId   String
  createdAt  DateTime @default(now())

  @@index([articleSlug, createdAt])
  @@index([viewerId, createdAt])
}

model ArticleLike {
  id          String   @id @default(cuid())
  articleSlug String
  viewerId    String
  createdAt   DateTime @default(now())

  @@unique([articleSlug, viewerId])
  @@index([articleSlug, createdAt])
}

model Comment {
  id          String   @id @default(cuid())
  articleSlug String
  authorName  String
  content     String
  status      CommentStatus @default(APPROVED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([articleSlug, createdAt])
  @@index([status, createdAt])
}
