generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum CommentStatus {
  APPROVED
  HIDDEN
}

enum MediaProvider {
  OSS
  COS
  R2
}

enum MediaAssetStatus {
  ACTIVE
  DELETING
  DELETE_FAILED
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  name               String?
  avatarUrl          String?
  passwordHash       String
  role               UserRole          @default(USER)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lastEditedArticles Article[]         @relation("ArticleLastEditedBy")
  articleRevisions   ArticleRevision[] @relation("ArticleRevisionCreatedBy")
  mediaAssets        MediaAsset[]
  comments           Comment[]
  agentTokens        AgentToken[]
}

enum AgentAccess {
  READ
  DRAFT
  PUBLISH
}

model AgentToken {
  id        String      @id @default(cuid())
  ownerId   String
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  digest    String      @unique
  access    AgentAccess @default(DRAFT)
  createdAt DateTime    @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([ownerId, createdAt])
}

model Article {
  id                 String            @id @default(cuid())
  version            String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  archiveNumber      BigInt            @unique @default(autoincrement())
  slug               String            @unique
  title              String
  desc               String
  content            String
  category           String
  tags               String[]
  cover              String?
  searchDocument     String            @default("")
  draft              Boolean           @default(true)
  publishedAt        DateTime
  legacySourcePath   String?
  lastEditedByUserId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lastEditedBy       User?                   @relation("ArticleLastEditedBy", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)
  revisions          ArticleRevision[]
  mediaReferences    ArticleMediaReference[]

  @@index([draft, publishedAt])
  @@index([category, publishedAt])
}

model ArticleRevision {
  id              String   @id @default(cuid())
  articleId       String
  title           String
  desc            String
  content         String
  category        String
  tags            String[]
  cover           String?
  draft           Boolean
  publishedAt     DateTime
  createdByUserId String?
  createdAt       DateTime @default(now())
  reason          String?
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("ArticleRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([createdByUserId, createdAt])
}

model PageView {
  id         String   @id @default(cuid())
  articleSlug String
  viewerId   String
  createdAt  DateTime @default(now())

  @@index([articleSlug, createdAt])
  @@index([viewerId, createdAt])
}

model ArticleLike {
  id          String   @id @default(cuid())
  articleSlug String
  viewerId    String
  createdAt   DateTime @default(now())

  @@unique([articleSlug, viewerId])
  @@index([articleSlug, createdAt])
}

model Comment {
  id          String        @id @default(cuid())
  articleSlug String
  userId      String?
  parentId    String?
  authorName  String
  content     String
  status      CommentStatus @default(APPROVED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")

  @@index([articleSlug, createdAt])
  @@index([articleSlug, parentId, createdAt])
  @@index([parentId, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model SiteConfig {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id               String           @id @default(cuid())
  displayName      String
  provider         MediaProvider
  objectKey        String           @unique
  publicUrl        String           @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  status           MediaAssetStatus @default(ACTIVE)
  uploadedByUserId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  uploadedBy        User?                   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  articleReferences ArticleMediaReference[]

  @@index([status, createdAt])
  @@index([displayName])
}

model ArticleMediaReference {
  id                    String     @id @default(cuid())
  articleId             String
  mediaAssetId          String
  contentReferenceCount Int        @default(0)
  coverReference        Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  article               Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  mediaAsset            MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([articleId, mediaAssetId])
  @@index([mediaAssetId])
  @@index([articleId])
}
