DATABASE_URL="postgresql://postgres:postgres@localhost:5432/level-insouciant?schema=public"
# Optional direct PostgreSQL endpoint for Prisma migrations (for example, Neon without `-pooler`).
DIRECT_URL=""
SITE_URL="http://localhost:21544"
# Compose supplies these safe overrides; credentials stay in DATABASE_URL.
DATABASE_HOST_OVERRIDE="postgresql"
DATABASE_NAME_OVERRIDE="level-insouciant"
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-first"
MEDIA_STORAGE_PROVIDER="r2"
OSS_REGION=""
OSS_BUCKET=""
OSS_ENDPOINT=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_PUBLIC_BASE_URL=""
COS_REGION=""
COS_BUCKET=""
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_PUBLIC_BASE_URL=""
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL=""

# Optional parallel deployment / rollback settings
COMPOSE_PROJECT_NAME="level-insouciant"
BLOG_CONTAINER_NAME="level-insouciant-web"
BLOG_HTTP_PORT="21544"
BLOG_IMAGE="level-insouciant:local"
