---
import { ClientRouter } from "astro:transitions"
import type { Metadata } from "@/types/seo"
import { getSiteConfig } from "@/lib/site-config"
import { getCurrentUser, requireAdmin, getUserDisplayName } from "@/lib/auth"
import { createWebsiteJsonLdString } from "@/lib/seo"
import { SiteHeader } from "@/components/blog/site-header"
import { SiteFooter } from "@/components/blog/site-footer"
import AdminLayout from "@/components/providers/admin-layout"
import "@/styles/globals.css"
import "katex/dist/katex.min.css"
import "@fontsource/barlow-condensed/400.css"
import "@fontsource/barlow-condensed/500.css"
import "@fontsource/barlow-condensed/600.css"
import "@fontsource/barlow-condensed/700.css"
import "@fontsource/cormorant-garamond/400.css"
import "@fontsource/cormorant-garamond/500.css"
import "@fontsource/cormorant-garamond/600.css"
import "@fontsource/cormorant-garamond/700.css"
import "@fontsource/cormorant-garamond/400-italic.css"
import "@fontsource/cormorant-garamond/500-italic.css"
import "@fontsource/cormorant-garamond/600-italic.css"
import "@fontsource/cormorant-garamond/700-italic.css"
import "@fontsource/ibm-plex-mono/400.css"
import "@fontsource/ibm-plex-mono/500.css"
interface Props {
  metadata?: Metadata
  protectedAdmin?: boolean
}
const { metadata = {}, protectedAdmin = false } = Astro.props
const siteConfig = await getSiteConfig()
const user = protectedAdmin ? await requireAdmin() : await getCurrentUser()
const isAdmin = Astro.url.pathname.startsWith("/admin")
const title =
  typeof metadata.title === "string"
    ? `${metadata.title} | ${siteConfig.name}`
    : (metadata.title?.absolute ?? siteConfig.name)
const og = metadata.openGraph
const location = Astro.url.pathname + Astro.url.search
---

<!doctype html>
<html lang={siteConfig.language} class="antialiased font-sans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content={metadata.description ?? siteConfig.description}
    />
    <meta name="keywords" content={metadata.keywords?.join(", ")} />
    <meta name="author" content={siteConfig.author} />
    <meta name="application-name" content={siteConfig.name} />
    <link rel="icon" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="canonical" href={metadata.alternates?.canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      href="/rss.xml"
      title={siteConfig.name}
    />
    <meta
      name="robots"
      content={
        isAdmin
          ? "noindex, nofollow"
          : metadata.robots
            ? `${metadata.robots.index === false ? "noindex" : "index"}, ${metadata.robots.follow === false ? "nofollow" : "follow"}`
            : "index, follow"
      }
    />
    {og && (
      <>
        <meta property="og:type" content={og.type} />
        <meta property="og:url" content={og.url} />
        <meta property="og:title" content={og.title} />
        <meta property="og:description" content={og.description} />
        <meta property="og:site_name" content={og.siteName} />
        <meta property="og:locale" content={og.locale} />
        {og.images?.map((image) => (
          <>
            <meta property="og:image" content={image.url} />
            <meta property="og:image:alt" content={image.alt} />
          </>
        ))}
        <meta property="article:published_time" content={og.publishedTime} />
        <meta property="article:modified_time" content={og.modifiedTime} />
        {og.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    {metadata.twitter && (
      <>
        <meta name="twitter:card" content={metadata.twitter.card} />
        <meta name="twitter:title" content={metadata.twitter.title} />
        <meta
          name="twitter:description"
          content={metadata.twitter.description}
        />
        {metadata.twitter.images?.map((image) => (
          <meta name="twitter:image" content={image} />
        ))}
      </>
    )}
    {!isAdmin && <ClientRouter />}
  </head>
  <body class="min-h-svh">
    <script
      type="application/ld+json"
      set:html={createWebsiteJsonLdString(siteConfig)}
    />
    <div
      class:list={[
        "flex min-h-svh flex-col",
        !isAdmin && "site-console relative overflow-x-clip",
      ]}
    >
      {!isAdmin && (
        <>
          <div
            aria-hidden="true"
            class="public-atmosphere-base pointer-events-none fixed inset-0 z-[1]"
          />
          <div
            aria-hidden="true"
            class="public-atmosphere-grain pointer-events-none fixed inset-0 z-[1]"
          />
          <div
            aria-hidden="true"
            class="public-atmosphere-scanline pointer-events-none fixed inset-0 z-[1]"
          />
          <div
            aria-hidden="true"
            class="public-atmosphere-vignette pointer-events-none fixed inset-0 z-[1]"
          />
        </>
      )}
      <div
        class:list={["flex min-h-svh flex-col", !isAdmin && "relative z-10"]}
      >
        {!isAdmin && (
          <SiteHeader user={user} siteConfig={siteConfig} client:idle />
        )}
        {protectedAdmin && user ? (
          <AdminLayout
            location={location}
            siteIconUrl="/icon.png"
            userImage={user.image}
            userName={getUserDisplayName(user)}
            siteName={siteConfig.name}
            client:load
          >
            <slot />
          </AdminLayout>
        ) : (
          <slot />
        )}
        {!isAdmin && <SiteFooter siteConfig={siteConfig} />}
      </div>
    </div>
  </body>
</html>
<style is:global>
  /* Match the previous self-hosted font metrics and CJK fallback order. */
  @font-face {
    font-family: "Barlow Condensed Fallback";
    src: local("Arial");
    ascent-override: 130.73%;
    descent-override: 26.15%;
    line-gap-override: 0%;
    size-adjust: 76.49%;
  }
  @font-face {
    font-family: "Cormorant Garamond Fallback";
    src: local("Times New Roman");
    ascent-override: 95.27%;
    descent-override: 29.59%;
    line-gap-override: 0%;
    size-adjust: 96.98%;
  }
  @font-face {
    font-family: "IBM Plex Mono Fallback";
    src: local("Arial");
    ascent-override: 76.16%;
    descent-override: 20.43%;
    line-gap-override: 0%;
    size-adjust: 134.59%;
  }
  :root {
    --font-sans: "Barlow Condensed", "Barlow Condensed Fallback";
    --font-serif: "Cormorant Garamond", "Cormorant Garamond Fallback";
    --font-mono: "IBM Plex Mono", "IBM Plex Mono Fallback";
  }
</style>
<script>
  // Admin transitions intentionally use complete documents (editor and auth state reset).
  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLAnchorElement>('a[href^="/admin"]')
      .forEach((link) => (link.dataset.astroReload = ""))
  })
</script>
