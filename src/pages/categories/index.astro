---
import BaseLayout from "@/layouts/BaseLayout.astro"
import Page from "@/views/categories-index"
import { load, generateMetadata } from "@/server/pages/categories-index"
const data = await load()
const metadata = await generateMetadata()
---

<BaseLayout metadata={metadata} protectedAdmin={false}>
  <Page
    {...data}
    location={Astro.url.pathname + Astro.url.search}
    client:idle
  />
</BaseLayout>
