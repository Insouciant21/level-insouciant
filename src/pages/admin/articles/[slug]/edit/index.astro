---
import BaseLayout from "@/layouts/BaseLayout.astro"
import Page from "@/views/admin-articles-slug-edit-index"
import {
  load,
  generateMetadata,
} from "@/server/pages/admin-articles-slug-edit-index"
import { requireAdmin } from "@/lib/auth"
await requireAdmin()
const input = {
  params: Promise.resolve(Astro.params as { slug: string }),
  searchParams: Promise.resolve(Object.fromEntries(Astro.url.searchParams)),
}
const data = await load(input)
const metadata = await generateMetadata()
---

<BaseLayout metadata={metadata} protectedAdmin={true}>
  <Page
    {...data}
    location={Astro.url.pathname + Astro.url.search}
    client:load
  />
</BaseLayout>
