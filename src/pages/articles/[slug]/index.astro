---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { ArrowLeft } from "lucide-react"
import { ArticleCard } from "@/components/blog/article-card"
import { ArticlePaginationNav } from "@/components/blog/article-pagination-nav"
import { ArticleReadingSurface } from "@/components/blog/article-reading-surface"
import { ArticleTableOfContents } from "@/components/blog/article-table-of-contents"
import ArticleEngagementIsland from "@/components/blog/article-engagement-island"
import { MotionReveal } from "@/components/motion/page-transition"
import { TagList } from "@/components/blog/tag-list"
import { renderMdx } from "@/components/blog/content-prose"
import { getArchiveSignal } from "@/lib/archive-presentation"
import {
  getArticleBySlug,
  getArticlePagination,
  getRelatedArticles,
  formatDisplayDate,
} from "@/lib/content"
import { createArticleMetadata, createArticleJsonLd } from "@/lib/seo"
import { getSiteConfig } from "@/lib/site-config"
import { extractTableOfContents } from "@/lib/toc"
import { notFound } from "@/server/request-context"

const articleDocumentPanelClass = "public-summary-panel-document"
const articleHeaderBadgeClass =
  "public-summary-chip border-[#73766f]/55 bg-[#d9d1ad]/64 px-3 py-1 text-foreground shadow-[inset_0_1px_0_rgba(255,252,225,0.18)]"

function estimateReadingMinutes(source: string) {
  const plain = source
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`[^`]*`/g, " ")
    .replace(/[#>*_~\-\[\]()!]/g, " ")
  const cjkCount = (plain.match(/[\u4e00-\u9fa5]/g) ?? []).length
  const wordCount = (
    plain.replace(/[\u4e00-\u9fa5]/g, " ").match(/[A-Za-z0-9_]+/g) ?? []
  ).length

  return Math.max(1, Math.ceil((cjkCount + wordCount * 1.4) / 380))
}

const { slug } = Astro.params
if (!slug) notFound()
const [article, siteConfig] = await Promise.all([
  getArticleBySlug(slug),
  getSiteConfig(),
])

if (!article) {
  notFound()
}

const [relatedArticles, pagination] = await Promise.all([
  getRelatedArticles(article),
  getArticlePagination(article.slug),
])
const tocItems = extractTableOfContents(article.content)
const signal = getArchiveSignal(article)
const readingMinutes = estimateReadingMinutes(article.content)
---

<BaseLayout metadata={createArticleMetadata(article, siteConfig)}>
  <main class="relative z-10 mx-auto flex w-full max-w-[88rem] flex-1 flex-col gap-10 px-5 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <script
      type="application/ld+json"
      set:html={createArticleJsonLd(article, siteConfig)}
    />
    <div class="mx-auto grid w-full max-w-[1200px] gap-8 md:gap-10 xl:grid-cols-[minmax(0,1fr)_310px] xl:items-start">
      <ArticleReadingSurface client:idle>
        <div
          class={`${articleDocumentPanelClass} mx-auto w-full max-w-4xl px-5 py-6 sm:px-8 sm:py-8 md:px-14 md:py-11`}
        >
          <a
            href="/articles"
            class="inline-flex items-center gap-2 font-mono text-xs font-medium tracking-[0.2em] text-muted-foreground uppercase transition duration-200 hover:text-foreground"
          >
            <ArrowLeft className="size-3.5" />
            返回档案索引
          </a>

          <header class="mt-6 border-b border-[#181b17]/65 pb-8 shadow-[0_1px_0_rgba(255,252,225,0.16)]">
            <div class="flex flex-wrap items-center justify-between gap-3 font-mono text-[0.68rem] font-medium tracking-[0.22em] text-muted-foreground uppercase">
              <span>M.E.G. Database // Archive File</span>
              <span>
                {formatDisplayDate(article.date)} · 约 {readingMinutes} 分钟阅读
              </span>
            </div>

            <h1 class="mt-5 font-serif text-3xl leading-[1.15] font-bold tracking-tight text-balance break-words text-foreground sm:text-5xl md:text-[3.35rem]">
              {article.title}
            </h1>
            {article.desc ? (
              <p class="mt-5 max-w-3xl text-base leading-8 text-foreground/78 md:text-lg">
                {article.desc}
              </p>
            ) : null}

            <div class="mt-6 flex flex-wrap gap-2.5 font-mono text-[0.7rem] font-medium tracking-[0.2em] uppercase">
              <span class="utility-charcoal-chip border border-[#181b17] px-3 py-1">
                Code: {signal.designation}
              </span>
              <span class={articleHeaderBadgeClass}>
                Category: {article.category}
              </span>
            </div>

            {article.tags.length > 0 ? (
              <div class="mt-5">
                <TagList tags={article.tags} />
              </div>
            ) : null}
          </header>

          {article.cover ? (
            <figure class="mt-8 overflow-hidden rounded-[0.25rem] border border-[#73766f]/52 bg-[#c6bd99]/45 p-2 shadow-[inset_0_1px_0_rgba(255,252,225,0.16),0_14px_32px_-28px_rgba(0,0,0,0.34)] sm:p-2.5">
              {/* Object-storage domains are runtime-configured, so this URL cannot be statically allowlisted. */}
              <img
                src={article.cover}
                alt={article.title}
                class="max-h-[24rem] w-full rounded-[0.1875rem] object-cover"
              />
              <figcaption class="mt-2 flex items-center justify-between px-1 font-mono text-[0.62rem] tracking-[0.18em] text-muted-foreground uppercase">
                <span>SPECIMEN // {signal.designation}</span>
                <span>ARCHIVE COVER PLATE</span>
              </figcaption>
            </figure>
          ) : null}

          <ArticleTableOfContents
            client:media="(max-width: 1279px)"
            items={tocItems}
            className="mt-8 xl:hidden"
          />

          <div class="mt-10">
            <Fragment set:html={await renderMdx(article.content)} />
          </div>
        </div>
      </ArticleReadingSurface>

      <ArticleTableOfContents
        client:media="(min-width: 1280px)"
        items={tocItems}
        variant="desktop-floating"
      />
    </div>

    <MotionReveal client:visible delay={0.1}>
      <ArticleEngagementIsland
        slug={article.slug}
        location={Astro.url.pathname}
        client:visible
      />
    </MotionReveal>

    <MotionReveal client:visible delay={0.15}>
      <ArticlePaginationNav
        previous={pagination?.previous ?? null}
        next={pagination?.next ?? null}
      />
    </MotionReveal>

    {relatedArticles.length > 0 ? (
      <MotionReveal client:visible delay={0.2}>
        <section class="mx-auto grid w-full max-w-[1200px] gap-4">
          <div class="site-section-header pb-3">
            <div>
              <p class="utility-kicker">Cross Reference</p>
              <h2 class="mt-1 text-xl font-semibold tracking-tight">
                相关文章
              </h2>
            </div>
            <p class="text-sm text-muted-foreground">根据标签与分类自动关联</p>
          </div>
          <div class="grid gap-4">
            {relatedArticles.map((entry) => (
              <ArticleCard article={entry} />
            ))}
          </div>
        </section>
      </MotionReveal>
    ) : null}
  </main>
</BaseLayout>
<script>
  document.addEventListener("click", async (event) => {
    const button =
      event.target instanceof Element
        ? event.target.closest<HTMLButtonElement>("[data-copy-code]")
        : null
    if (!button) return
    try {
      await navigator.clipboard.writeText(button.dataset.copyCode ?? "")
      button.dataset.copied = "true"
      button.setAttribute("aria-label", "代码已复制")
      const label = button.querySelector("[data-copy-label]")
      if (label) label.textContent = "已复制"
    } catch {
      const label = button.querySelector("[data-copy-label]")
      if (label) label.textContent = "复制失败"
    }
    setTimeout(() => {
      if (button.isConnected) {
        button.dataset.copied = "false"
        button.setAttribute("aria-label", "复制代码")
        const label = button.querySelector("[data-copy-label]")
        if (label) label.textContent = "复制"
      }
    }, 2000)
  })
</script>
